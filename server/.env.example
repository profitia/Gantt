# SQLite (local dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Render production) - change schema.prisma provider to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/gantt_db?schema=public"
# Also install: npm install @prisma/adapter-pg pg @types/pg
# And update src/prisma.ts to use PrismaPg adapter

# Optional: restrict CORS to your Render frontend
# FRONTEND_URL="https://your-frontend.onrender.com"

PORT=3000
